# Copia este fichero a `.env` y pon tus datos reales. `.env` esta en .gitignore.
#
# La SEC EXIGE identificarse con nombre y correo reales en el User-Agent y
# registra cada peticion. Sin esto responde 403, y quien insiste con un agente
# generico acaba bloqueado por IP. Es el unico secreto que necesita el modelo:
# todas las fuentes de datos son publicas y gratuitas.
SEC_EDGAR_USER_AGENT=Nombre Apellido tu@correo.com

# OJO CON POWERSHELL: `Out-File -Encoding utf8` mete un BOM que convierte la
# primera clave en un nombre invisible. El lector usa utf-8-sig y se lo come,
# pero si editas a mano guarda sin BOM, o usa:
#   [System.IO.File]::WriteAllText("$PWD\.env", "SEC_EDGAR_USER_AGENT=...")
